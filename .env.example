# Скопируйте в .env.local и поменяйте при необходимости. Все значения необязательны.

# --- разработка (npm run dev / npm run preview) ---
# Куда dev-сервер проксирует /api и /admin
DEV_BACKEND_URL=http://localhost:8080

# --- сборка (npm run build) ---
# Базовый путь, если приложение лежит не в корне домена, например /kazbeef/
# VITE_BASE=/

# Адрес бэкенда на другом origin. Обычно не нужен: nginx из этого проекта проксирует /api и /admin,
# и браузер видит один origin. Если задать — на бэкенде понадобятся CORS с credentials
# и cookie сессии с SameSite=None; Secure.
# VITE_API_URL=https://api.example.kz
