# ${BACKEND_URL} подставляется при старте контейнера. Переменные nginx ($host, $uri и т. д.) остаются как есть.
# За внешним HTTPS-прокси (Caddy) схема приходит в X-Forwarded-Proto: её и передаём бэкенду.
# Без прокси заголовка нет — передаём собственную схему nginx.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Данные и админка — на бэкенд. Браузер видит один origin, поэтому cookie сессии и CSRF работают без CORS.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/conf.d/proxy.inc;
    }
    location /admin/ {
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/conf.d/proxy.inc;
        # документы базы знаний: до 50 МБ каждый, несколько за раз
        client_max_body_size 200m;
    }
    # Публичный чат: ответ идёт потоком Server-Sent Events. Без отключения буферизации текст пришёл бы
    # одним куском в конце. Тайм-аут чтения (300 с) уже задан в proxy.inc: повторить proxy_read_timeout
    # в этом же блоке nginx не даст — директива не может встречаться в одном контексте дважды.
    location /public/ {
        proxy_pass ${BACKEND_URL};
        include /etc/nginx/conf.d/proxy.inc;
        proxy_buffering off;
        proxy_cache off;
        add_header X-Accel-Buffering no;
        gzip off;
    }

    # Файлы сборки содержат хэш в имени: кешируются навсегда
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Клиентские маршруты (/map, /events, ...) отдают index.html; сам он не кешируется, чтобы новая сборка подхватывалась сразу
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
